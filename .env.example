# Local development values only. Replace credentials for a deployed environment.
APP_NAME=Cowrite
DEBUG=false
# Empty for direct uvicorn; Compose supplies /api behind Nginx.
API_ROOT_PATH=
# Local demo only. Production must replace this with 32+ random bytes.
JWT_SECRET=cowrite-local-development-secret-change-before-deploy
# GitHub OAuth App. Leave credentials unset to disable GitHub login.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=["http://localhost:8080"]
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_FROM=Cowrite <noreply@cowrite.local>
EXPORTS_DIR=exports
PDF_FONTS_DIR=/usr/share/fonts/truetype/dejavu
LOG_LEVEL=INFO
MAILPIT_PORT=8025
PROMETHEUS_PORT=9090

POSTGRES_USER=cowrite
POSTGRES_PASSWORD=cowrite-local
POSTGRES_DB=cowrite

# URLs for running uvicorn directly on the host.
# Compose supplies URLs with Docker service names to the API container.
DATABASE_URL=postgresql+asyncpg://cowrite:cowrite-local@localhost:5432/cowrite
REDIS_CACHE_URL=redis://localhost:6379/0
# Optional: opt in to integration tests using a SEPARATE database ending in _test.
# TEST_DATABASE_URL=postgresql+asyncpg://cowrite:cowrite-local@localhost:5432/cowrite_test

# Ports are bound to loopback, not to the external network.
API_PORT=8000
FRONTEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
